{
  "uid": "atlas-operations",
  "title": "Atlas — Operational Resilience",
  "description": "Private operational telemetry. HTTP routes are templates; no tenant/user/job labels. Queue gauges repeat per API replica and use max. The alert journal is not human paging.",
  "tags": ["atlas", "operations"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API scrape availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"atlas-api\"}",
          "legendFormat": "{{instance}} {{route}} {{dependency}} {{status}} {{outcome}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Worker dependencies",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
