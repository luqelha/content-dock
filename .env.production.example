POSTGRES_USER=atlas
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=atlas
# Bootstrap/migration credentials above must never be used by the API.
# Provision atlas_app after migrations using scripts/database/create-runtime-role.sql.
# URL-encode the password in this URL; use a different secret from POSTGRES_PASSWORD.
DATABASE_APP_URL=postgresql://atlas_app:replace-with-a-separate-random-password@postgres:5432/atlas?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
AUTH_PROXY_SECRET=replace-with-a-separate-32-random-characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
RABBITMQ_USER=atlas
RABBITMQ_PASS=replace-with-a-long-random-password
CORS_ORIGINS=https://atlas.example.com
# Optional TLS profile: point this public hostname to the host before enabling.
SITE_DOMAIN=atlas.example.com
ACME_EMAIL=ops@example.com

# Enable only after reviewing a retention dry-run; old encrypted orphans get a 48h grace.
STORAGE_RETENTION_ENABLED=false
# Keep true until an operator approves deletion policy and restore evidence.
STORAGE_RETENTION_DRY_RUN=true

# Required only with docker-compose.observability.yml; use a separate operator secret.
GRAFANA_ADMIN_USER=atlas-operator
GRAFANA_ADMIN_PASSWORD=replace-with-a-separate-long-random-password
