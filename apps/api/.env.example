# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atlas_db?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# RabbitMQ Configuration
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Application Settings
PORT=4000
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="replace-with-another-32-random-characters"
JWT_REFRESH_EXPIRATION="7d"

# Production requires a persistent 32-byte encryption key encoded as 64 hex characters.
# Development generates storage/.development-key automatically; back it up with files.
# STORAGE_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000
# Use a distinct >=32-character secret, shared with the web server, behind the trusted edge.
# Required in production; never expose it as a NEXT_PUBLIC variable.
# AUTH_PROXY_SECRET=
# Review a dry-run and backups before enabling deletion of old encrypted orphans.
STORAGE_RETENTION_ENABLED=false
# Keep true until an operator approves deletion policy and restore evidence.
STORAGE_RETENTION_DRY_RUN=true
